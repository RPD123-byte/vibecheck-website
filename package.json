{
  "name": "vibecheck-website",
  "version": "1.0.0",
  "description": "Landing page for Vibecheck",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n download,site -c yellow,cyan \"node server.js\" \"vite --host 127.0.0.1 --port 4175\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "start": "node server.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "concurrently": "9.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
